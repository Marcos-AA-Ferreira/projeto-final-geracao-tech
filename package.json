{
  "name": "projeto-final-geracao-tech",
  "version": "1.0.0",
  "description": "API Biblioteca de Mangás - Projeto B",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --out-dir dist",
    "start:prod": "node dist/server.js",
